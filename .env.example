# JRE Account Credentials
JRE_USER_ID=your_jre_user_id
JRE_USER_PASS=your_jre_password

# 会社名（半角英数字でOK - 自動的に全角に変換されます）
# Examples:
# - 株式会社Example → 自動的に「株式会社」「Ｅｘａｍｐｌｅ」に分割
# - Example Corp → 自動的に「Ｅｘａｍｐｌｅ」「Ｃｏｒｐ」に分割
# - ABC Company Ltd. → 自動的に「ＡＢＣ　Ｃｏｍｐａｎｙ」「Ｌｔｄ．」に分割
RECIPIENT_COMPANY=株式会社Example

# 出力先ディレクトリ（オプション）
# PDFファイルと履歴ファイルの出力先ディレクトリ
# 未設定の場合は'output'ディレクトリに出力されます
# OUTPUT_DIR=/path/to/output/directory
